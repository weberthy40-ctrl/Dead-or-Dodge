{
  "name": "moba-training",
  "version": "1.0.0-rc.17",
  "private": true,
  "description": "Treinador de Esquiva, Precis\u00e3o, Kiting e Reflexos com progresso local.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "test:browser": "node scripts/browser-smoke.js",
    "test:gameplay": "node scripts/browser-feedback.js",
    "test:storage": "node scripts/browser-native.js",
    "test:dodge": "node scripts/browser-dodge.js",
    "test:isolation": "node scripts/browser-isolation.js",
    "test:e2e": "npm run build && node scripts/browser-runner.js",
    "check": "npm test && npm run lint && npm audit && npm run test:e2e"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
